# Environment Variables Configuration
# Copy this file to .env and configure your production credentials

NODE_ENV=production
PORT=5000

# MongoDB Atlas Cluster Connection String:
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/audit-trail?retryWrites=true&w=majority&appName=AuditTrailCluster

# JWT Authentication Secret Key
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production

# Optional: Disable background worker if running worker on a separate instance
DISABLE_PROJECTION_WORKER=false
